diff --git a/foreman/tests/surveyor/test_harmony_zero_age.py b/foreman/tests/surveyor/test_harmony_zero_age.py
new file mode 100644
index 00000000..4953e3f9
--- /dev/null
+++ b/foreman/tests/surveyor/test_harmony_zero_age.py
@@ -0,0 +1,42 @@
+import unittest
+
+from data_refinery_foreman.surveyor.harmony import Harmonizer
+
+
+class ZeroAgeTests(unittest.TestCase):
+    def setUp(self):
+        self.harmonizer = Harmonizer()
+
+    def test_zero_age_is_retained(self):
+        for value in [0, 0.0, "0", "0.0"]:
+            with self.subTest(value=value):
+                result = {}
+                self.harmonizer.harmonize_field({"age": value}, result, "age_fields")
+                self.assertEqual(result, {"age": 0.0})
+
+    def test_zero_age_field_variants_are_retained(self):
+        for key in ["Age", "age (years)", "characteristics_age"]:
+            with self.subTest(key=key):
+                result = {}
+                self.harmonizer.harmonize_field({key: "0"}, result, "age_fields")
+                self.assertEqual(result, {"age": 0.0})
+
+    def test_empty_and_unknown_age_stay_absent(self):
+        for value in ["", "unknown"]:
+            with self.subTest(value=value):
+                result = {}
+                self.harmonizer.harmonize_field({"age": value}, result, "age_fields")
+                self.assertNotIn("age", result)
+
+    def test_positive_age_is_unchanged(self):
+        result = {}
+        self.harmonizer.harmonize_field({"age": "2"}, result, "age_fields")
+        self.assertEqual(result, {"age": 2.0})
+
+    def test_full_sample_keeps_zero_and_other_annotations(self):
+        result = self.harmonizer.harmonize_sample(
+            {"title": "constructed sample", "age": "0", "sex": "female"}
+        )
+        self.assertEqual(result["age"], 0.0)
+        self.assertEqual(result["sex"], "female")
+        self.assertEqual(result["title"], "constructed sample")
