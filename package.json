{
  "name": "scientific-software-lab",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "python3 site/build.py && python3 site/package.py",
    "test": "node site/verify.cjs",
    "test:overlap": "node projects/overlap-inspector/verify-browser.cjs",
    "lint": "prettier --check site/app.js site/deploy.cjs site/verify.cjs site/style.css site/template.html \"site/views/*.html\" .github/workflows/lab-delivery.yml package.json"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vercel": "65.4.0"
  }
}
