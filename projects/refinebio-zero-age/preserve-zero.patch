@@ -0,0 +1,21 @@
+import unittest
+from decimal import Decimal
+
+from data_refinery_common.models import Sample
+
+
+class ZeroAgeExportTests(unittest.TestCase):
+    def export_age(self, age):
+        sample = Sample(pk=1, title="constructed sample", age=age)
+        return sample.to_metadata_dict()["refinebio_age"]
+
+    def test_zero_age_is_exported(self):
+        for age in [0, 0.0, Decimal("0.000")]:
+            with self.subTest(age=age):
+                self.assertEqual(self.export_age(age), age)
+
+    def test_missing_age_is_empty(self):
+        self.assertEqual(self.export_age(None), "")
+
+    def test_positive_age_is_unchanged(self):
+        self.assertEqual(self.export_age(Decimal("2.000")), Decimal("2.000"))
