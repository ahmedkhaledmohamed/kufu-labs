+++ b/tests/test_stream_shape.py
@@ -0,0 +1,58 @@
+from collections.abc import Iterator
+
+import h5py
+import numpy as np
+import pytest
+from hdmf.backends.hdf5 import H5DataIO
+from hdmf.data_utils import DataChunkIterator
+from hdmf_zarr import ZarrDataIO
+
+from nwbinspector.utils import get_data_shape
+
+
+@pytest.mark.parametrize("wrapper", [lambda x: x, H5DataIO, ZarrDataIO])
+@pytest.mark.parametrize("strict", [False, True])
+def test_chunk_shape_does_not_advance_stream(wrapper, strict):
+    values = np.arange(1, 1001, dtype="int16").reshape(500, 2)
+    stream = DataChunkIterator(values, buffer_size=100)
+    wrapped = wrapper(stream)
+    for _ in range(4):
+        assert get_data_shape(wrapped, strict_no_data_load=strict) == (500, 2)
+    first = next(stream)
+    np.testing.assert_array_equal(first.data, values[:100])
+
+
+class SinglePassWithLength(Iterator):
+    def __init__(self):
+        self.iterator = iter([[1, 2], [3, 4]])
+        self.reads = 0
+
+    def __len__(self):
+        return 2
+
+    def __next__(self):
+        self.reads += 1
+        return next(self.iterator)
+
+
+@pytest.mark.parametrize("nested", [False, True])
+def test_unknown_single_pass_shape_is_not_inferred_by_reading(nested):
+    stream = SinglePassWithLength()
+    assert get_data_shape([stream] if nested else stream) is None
+    assert stream.reads == 0
+    assert next(stream) == [1, 2]
+
+
+def test_stored_resizable_dataset_uses_current_shape(tmp_path):
+    with h5py.File(tmp_path / "shape.h5", "w") as file:
+        data = file.create_dataset("data", data=np.zeros((5, 3)), maxshape=(None, 3))
+        assert get_data_shape(data) == (5, 3)
+        assert get_data_shape(data, strict_no_data_load=True) == (5, 3)
+
+
+@pytest.mark.parametrize(
+    "data,expected",
+    [([], (0,)), ([[1, 2], [3, 4]], (2, 2)), (("a", "b"), (2,)), ({"x": 1}, None)],
+)
+def test_materialized_shapes_unchanged(data, expected):
+    assert get_data_shape(data) == expected
